{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		// Mirrors the `layercake` alias in vite.config.js so the site type-checks
		"paths": {
			"layercake": ["./src/lib/index.js"],
			"layercake/*": ["./src/lib/*"]
		},
		"module": "es2022",
		"lib": ["es2021", "DOM"],
		"target": "es2021",
		"sourceMap": true,
		"strict": true
	},
	"include": ["./src/**/*.d.ts", "./src/**/*.js", "./src/**/*.ts", "./src/**/*.svelte"],
	"exclude": ["./src/_data/*"]
}
